  "dialogue": [
    { "id": "nia_first_meet", "speakerId": "nia_moss", "category": "first_meet", "text": { "key": "dialogue.nia.first_meet", "text": "You found the farm at a good time. The soil is awake." }, "priority": 80, "cooldownDays": 0, "setsFlagIds": ["met_nia_moss"] },
    { "id": "nia_daily", "speakerId": "nia_moss", "category": "daily", "text": { "key": "dialogue.nia.daily", "text": "Water early and the beds will forgive a busy afternoon." }, "priority": 10, "cooldownDays": 1 },
    { "id": "oren_first_meet", "speakerId": "oren_clay", "category": "first_meet", "text": { "key": "dialogue.oren.first_meet", "text": "If a hinge complains, listen before it breaks." }, "priority": 80, "cooldownDays": 0, "setsFlagIds": ["met_oren_clay"] },
    { "id": "oren_daily", "speakerId": "oren_clay", "category": "daily", "text": { "key": "dialogue.oren.daily", "text": "Stone, fiber, patience. Most repairs want those three." }, "priority": 10, "cooldownDays": 1 },
    { "id": "tavi_first_meet", "speakerId": "tavi_reed", "category": "first_meet", "text": { "key": "dialogue.tavi.first_meet", "text": "I keep the shelves honest and the road gossip sorted." }, "priority": 80, "cooldownDays": 0, "setsFlagIds": ["met_tavi_reed"] },
    { "id": "tavi_daily", "speakerId": "tavi_reed", "category": "daily", "text": { "key": "dialogue.tavi.daily", "text": "Bring me odd scraps if your bag gets too full." }, "priority": 10, "cooldownDays": 1 },
    { "id": "mara_first_meet", "speakerId": "mara_well", "category": "first_meet", "text": { "key": "dialogue.mara.first_meet", "text": "A village settles faster when someone keeps soup warm." }, "priority": 80, "cooldownDays": 0, "setsFlagIds": ["met_mara_well"] },
    { "id": "mara_daily", "speakerId": "mara_well", "category": "daily", "text": { "key": "dialogue.mara.daily", "text": "Fresh greens make even a small supper feel planned." }, "priority": 10, "cooldownDays": 1 },
    { "id": "ilo_first_meet", "speakerId": "ilo_fen", "category": "first_meet", "text": { "key": "dialogue.ilo.first_meet", "text": "The meadow leaves clues. Walk softly and it gives plenty." }, "priority": 80, "cooldownDays": 0, "setsFlagIds": ["met_ilo_fen"] },
    { "id": "ilo_daily", "speakerId": "ilo_fen", "category": "daily", "text": { "key": "dialogue.ilo.daily", "text": "I saw fresh fiber near the tall grass this morning." }, "priority": 10, "cooldownDays": 1 },
    { "id": "sena_first_meet", "speakerId": "sena_vale", "category": "first_meet", "text": { "key": "dialogue.sena.first_meet", "text": "Every path here has a record, even the overgrown ones." }, "priority": 80, "cooldownDays": 0, "setsFlagIds": ["met_sena_vale"] },
    { "id": "sena_daily", "speakerId": "sena_vale", "category": "daily", "text": { "key": "dialogue.sena.daily", "text": "If you find old stones, I can usually name their purpose." }, "priority": 10, "cooldownDays": 1 },
    { "id": "arrival_story_nia", "speakerId": "nia_moss", "category": "story_event", "text": { "key": "dialogue.story.arrival_nia", "text": "Start with the field by your door. Small harvests count." }, "priority": 100, "cooldownDays": 0, "setsFlagIds": ["story_arrival_dialogue_seen"] },
    { "id": "first_harvest_story_mara", "speakerId": "mara_well", "category": "story_event", "text": { "key": "dialogue.story.first_harvest_mara", "text": "That first basket changes the whole table." }, "priority": 100, "cooldownDays": 0, "setsFlagIds": ["story_first_harvest_dialogue_seen"] },
    { "id": "path_story_oren", "speakerId": "oren_clay", "category": "story_event", "text": { "key": "dialogue.story.path_oren", "text": "The path will hold now. Give it use and it will stay open." }, "priority": 100, "cooldownDays": 0, "setsFlagIds": ["story_path_dialogue_seen"] }
  ],
